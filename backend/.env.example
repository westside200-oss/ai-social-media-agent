# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_social_media
DATABASE_ECHO=false

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security & Encryption
ENCRYPTION_KEY=your-32-character-hex-key-12345678901234567890
SECRET_KEY=your-secret-key-for-jwt-tokens

# Platform API Versions
INSTAGRAM_API_VERSION=v18.0
TIKTOK_API_VERSION=v1

# Posting Schedule (Cameroon Time WAT/GMT+1)
FIRST_POST_TIME=12:00
SECOND_POST_TIME=18:00
TIMEZONE=Africa/Douala

# Server Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true

# AI Model Configuration
CLAUDE_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=1024
TEMPERATURE=0.7

# Content Generation
DEFAULT_CONTENT_THEME=fashion
MIN_CAPTION_LENGTH=30
MAX_CAPTION_LENGTH=2200

# Analytics
ANALYTICS_FETCH_INTERVAL=86400
KEEP_ANALYTICS_DAYS=90

# Feature Flags
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true
ENABLE_FACEBOOK=false
ENABLE_LINKEDIN=false
